# =============================================================================
# AI Barber WhatsApp Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for the mode you choose.
# Leave a mode's values blank to disable it.
#
# Two operating modes are supported:
#   (A) OpenWA Gateway  - LOCAL, no tunneling, no Meta signup (recommended)
#   (B) Meta Cloud API  - REQUIRES Cloudflare Tunnel (start.bat legacy mode)
# =============================================================================


# =============================================================================
# (A) OpenWA Gateway (https://github.com/rmyndharis/OpenWA)
# =============================================================================
# After running `setup-openwa.bat` + `start-openwa.bat`, open the OpenWA
# dashboard at http://localhost:2886 and:
#   1. Create an API key (Settings -^> API Keys)
#   2. Create a session named "barber-bot" and scan the QR with WhatsApp
#   3. Create a webhook pointing to http://localhost:8000/webhook
#        Events: message.received, session.status
#        Secret : barber-webhook-secret  (must match OPENWA_WEBHOOK_SECRET)
#   4. Paste the API key + session id below.
# =============================================================================
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=barber-bot
OPENWA_WEBHOOK_SECRET=barber-webhook-secret


# =============================================================================
# (B) Meta WhatsApp Cloud API  (used only when OpenWA values are blank)
# =============================================================================
# Get these from https://developers.facebook.com/ -> your app -> WhatsApp
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_ACCESS_TOKEN=your_permanent_or_long_lived_token
# WHATSAPP_VERIFY_TOKEN=barber_verify_2026
# BUSINESS_PHONE_NUMBER=15551234567


# =============================================================================
# AI Services
# =============================================================================
# Google Gemini (face analysis, free tier) - get a key at aistudio.google.com
GEMINI_API_KEY=

# Replicate (hair swap quality fallback) - https://replicate.com
REPLICATE_API_TOKEN=

# HuggingFace Inference API (additional fallback)
HUGGINGFACE_API_TOKEN=

# Cloudflare Workers AI (PRIMARY hair swap - free tier)
# Get Account ID + API Token from https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=


# =============================================================================
# Local Dev
# =============================================================================
# Number that receives a WhatsApp notification when a booking is confirmed
BARBER_PHONE_NUMBER=

# Cloudflare quick-tunnel URL (only used by start.bat legacy mode)
# This is auto-printed in the cloudflared window each launch and changes
# every restart, which is why the OpenWA mode above is strongly preferred.
NGROK_URL=
