# WhatsApp Cloud API (Meta Developer)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
BUSINESS_PHONE_NUMBER=15551234567

# Google Gemini API (AI Studio — free tier)
GEMINI_API_KEY=your_gemini_api_key

# Replicate (hair swap / virtual try-on)
REPLICATE_API_TOKEN=your_replicate_token

# FreeTheAI (img2img hair swap — free, get key via discord.gg/secrets)
FREETHEAI_API_KEY=your_freetheai_api_key

# HuggingFace Inference API (fallback for hair swap)
HUGGINGFACE_API_TOKEN=your_hf_token

# Barber notification
BARBER_PHONE_NUMBER=201234567890

# Local dev tunnel
NGROK_URL=https://your-tunnel.ngrok.io

# OpenWA Gateway (self-hosted WhatsApp API — replaces Meta Cloud API)
# Set these to switch from Meta to OpenWA
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=your_openwa_api_key
OPENWA_SESSION_ID=your_session_id
OPENWA_WEBHOOK_SECRET=your_webhook_secret
